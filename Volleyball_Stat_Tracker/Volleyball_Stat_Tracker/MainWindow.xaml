<Window x:Class="Volleyball_Stat_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volleyball Stat Tracker" Height="750" Width="550"
        Background="#F4F4F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Title -->
        <TextBlock Grid.Row="0" 
                   Text="Volleyball_Stat_Tracker" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Foreground="#2C3E50"/>

        <!-- Input Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Player Name" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtName" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Player Age" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtAge" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Player Minutes" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtMinutes" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Points" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtPoints" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Club Name" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtClub" Margin="0,0,0,5" Padding="6"/>
            </StackPanel>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2" 
                Click="AddPlayer"
                x:Name="BtnAdd" 
                Content="Add Player"
                Height="38" 
                Background="#27AE60" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="14"
                Margin="0,0,0,20"/>

        <!-- Section Subtitle -->
        <TextBlock Grid.Row="3" 
                   x:Name="TxtListTitle"
                   Visibility="Collapsed"
                   Text="Player List" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,10" 
                   Foreground="#34495E"/>

        <!-- Player List -->
        <ListView Grid.Row="4" 
                  x:Name="LstPlayers" 
                  Visibility="Collapsed"
                  Background="White" 
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Player Info (Column 0) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PlayerName}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="#555">
                                <Run Text="Club: "/><Run Text="{Binding ClubName}"/>
                                <Run Text=" | Age: "/><Run Text="{Binding PlayerAge}"/>
                                <Run Text=" | Minutes: "/><Run Text="{Binding PlayerMinutes}"/>
                                <Run Text=" | Points: "/><Run Text="{Binding Points}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Buttons (Column 1) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnUpdate"
                                    Click="UpdatePlayer"
                                    Content="Update" 
                                    Padding="10,5" 
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center" 
                                    Background="#2980B9" 
                                    Foreground="White" 
                                    FontWeight="Bold"/>

                            <Button x:Name="BtnDelete"
                                    Click="DeletePlayer"
                                    Content="Delete" 
                                    Padding="10,5" 
                                    VerticalAlignment="Center" 
                                    Background="#E74C3C" 
                                    Foreground="White" 
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
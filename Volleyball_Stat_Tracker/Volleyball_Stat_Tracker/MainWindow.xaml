<Window x:Class="Volleyball_Stat_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volleyball Stat Tracker" Height="750" Width="550"
        Background="#F4F4F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Title -->
        <TextBlock Grid.Row="0" 
                   Text="Volleyball_Stat_Tracker" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Foreground="#2C3E50"/>

        <!-- Input Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Ime igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtIme" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Godine igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtGodine" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Minutaža igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtMinutaza" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Broj poena" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtPoeni" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Ime kluba" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtKlub" Margin="0,0,0,5" Padding="6"/>
            </StackPanel>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2" 
                Click="DodajIgraca"
                x:Name="BtnDodaj" 
                Content="Dodaj" 
                Height="38" 
                Background="#27AE60" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="14"
                Margin="0,0,0,20"/>

        <!-- Section Subtitle (Skriveno dok se ne doda prvi igrač) -->
        <TextBlock Grid.Row="3" 
                   x:Name="TxtNaslovListe"
                   Visibility="Collapsed"
                   Text="Lista igrača" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,10" 
                   Foreground="#34495E"/>

        <!-- Player List (Skriveno dok se ne doda prvi igrač) -->
        <ListView Grid.Row="4" 
                  x:Name="LstIgraci" 
                  Visibility="Collapsed"
                  Background="White" 
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Podaci o igraču (Kolona 0) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding imeIgraca}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="#555">
                                <Run Text="Klub: "/><Run Text="{Binding imeKluba}"/>
                                <Run Text=" | Godine: "/><Run Text="{Binding godineIgraca}"/>
                                <Run Text=" | Minuta: "/><Run Text="{Binding minutazaIgraca}"/>
                                <Run Text=" | Poeni: "/><Run Text="{Binding brojPoena}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Akcijska dugmad (Kolona 1) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ubutton"
                                    Content="Update" 
                                    Padding="10,5" 
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center" 
                                    Background="#2980B9" 
                                    Foreground="White" 
                                    FontWeight="Bold"/>

                            <Button x:Name="dbutton"
                                    Click="Brisanje"
                                    Content="Delete" 
                                    Padding="10,5" 
                                    VerticalAlignment="Center" 
                                    Background="#E74C3C" 
                                    Foreground="White" 
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
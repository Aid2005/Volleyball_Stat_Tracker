<Window x:Class="Volleyball_Stat_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volleyball Stat Tracker" Height="750" Width="550"
        Background="#F4F4F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Main Title -->
        <TextBlock Grid.Row="0" 
                   Text="Volleyball_Stat_Tracker" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Foreground="#2C3E50"/>

        <!-- Input Form -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Ime igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtIme" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Godine igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtGodine" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Minutaža igrača" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtMinutaza" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Broj poena" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtPoeni" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Ime kluba" Margin="0,0,0,3" FontSize="12" Foreground="#666"/>
                <TextBox x:Name="TxtKlub" Margin="0,0,0,5" Padding="6"/>
            </StackPanel>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2" 
                x:Name="BtnDodaj" 
                Content="Dodaj" 
                Height="38" 
                Background="#27AE60" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="14"
                Margin="0,0,0,20"/>

        <!-- Section Subtitle -->
        <TextBlock Grid.Row="3" 
                   Text="Lista igrača" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,10" 
                   Foreground="#34495E"/>

        <!-- Player List with Dummy Data -->
        <ListView Grid.Row="4" x:Name="LstIgraci" Background="White" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mock Data Row 1 (Visual Preview) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Ime, FallbackValue='Marko Marković'}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock FontSize="12" Foreground="#555">
                                <Run Text="Klub: "/><Run Text="{Binding Klub, FallbackValue='OK Bosna'}"/>
                                <Run Text=" | Godine: "/><Run Text="{Binding Godine, FallbackValue='24'}"/>
                                <Run Text=" | Minuta: "/><Run Text="{Binding Minutaza, FallbackValue='120'}"/>
                                <Run Text=" | Poeni: "/><Run Text="{Binding Poeni, FallbackValue='45'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="Update" 
                                Padding="12,6" 
                                VerticalAlignment="Center" 
                                Background="#2980B9" 
                                Foreground="White" 
                                FontWeight="Bold"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- Dummy items for visual structure in XAML -->
            <ListViewItem>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Marko Marković" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Klub: OK Bosna | Godine: 24 | Minuta: 120 | Poeni: 45" FontSize="12" Foreground="#555"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Update" Padding="12,6" VerticalAlignment="Center" Background="#2980B9" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </ListViewItem>

            <ListViewItem>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Petar Petrović" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Klub: OK Mladost | Godine: 21 | Minuta: 95 | Poeni: 28" FontSize="12" Foreground="#555"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Update" Padding="12,6" VerticalAlignment="Center" Background="#2980B9" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </ListViewItem>
        </ListView>
    </Grid>
</Window>
